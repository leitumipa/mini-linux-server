[Unit]
Description=Mini Linux Server Demo Application
After=network.target

[Service]
Type=simple
User=appsvc
Group=appteam
WorkingDirectory=/srv/mini-linux-server/app
ExecStart=/usr/bin/python3 /srv/mini-linux-server/app/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
